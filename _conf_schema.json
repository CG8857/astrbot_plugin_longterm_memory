{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用长期记忆",
        "type": "bool",
        "default": true,
        "hint": "关闭后不再记录、检索和注入记忆。"
      },
      "capture_group_all": {
        "description": "记录群聊中所有消息",
        "type": "bool",
        "default": false,
        "hint": "默认只记录与机器人对话的群消息；开启后会记录群里每个人的发言，注意隐私与性能。"
      },
      "enable_image_understanding": {
        "description": "识别图片内容",
        "type": "bool",
        "default": true,
        "hint": "使用多模态模型描述图片，并写入记忆。需要模型支持图片输入。"
      },
      "max_images_per_message": {
        "description": "每条消息最多识别的图片数",
        "type": "int",
        "default": 1,
        "slider": { "min": 0, "max": 4, "step": 1 }
      },
      "ignore_commands": {
        "description": "忽略以 / 开头的指令",
        "type": "bool",
        "default": true,
        "hint": "避免把管理指令写入记忆。"
      }
    }
  },
  "memory": {
    "description": "记忆抽取与每日整理",
    "type": "object",
    "items": {
      "enable_auto_extract": {
        "description": "自动抽取记忆",
        "type": "bool",
        "default": true,
        "hint": "达到消息条数后自动调用 LLM 抽取记忆。"
      },
      "extract_every_n_messages": {
        "description": "每 N 条用户消息抽取一次",
        "type": "int",
        "default": 8,
        "slider": { "min": 1, "max": 50, "step": 1 }
      },
      "consolidation_time": {
        "description": "每日整理时间",
        "type": "string",
        "default": "00:00",
        "hint": "24 小时制 HH:MM，整理此前尚未整理的日期。修改后无需重启。"
      },
      "catch_up_on_start": {
        "description": "启动时补整理遗漏日期",
        "type": "bool",
        "default": true
      },
      "profile_min_messages": {
        "description": "生成画像所需的最少消息数",
        "type": "int",
        "default": 6,
        "slider": { "min": 1, "max": 100, "step": 1 }
      },
      "profile_refresh_days": {
        "description": "画像自动刷新间隔（天）",
        "type": "int",
        "default": 3,
        "slider": { "min": 1, "max": 30, "step": 1 }
      },
      "retention_days": {
        "description": "数据保留天数",
        "type": "int",
        "default": 0,
        "hint": "0 表示永久保留；大于 0 时每日整理会删除更早的消息和记忆。"
      }
    }
  },
  "injection": {
    "description": "提示词注入",
    "type": "object",
    "items": {
      "inject_mode": {
        "description": "注入方式",
        "type": "string",
        "default": "extra_user_part",
        "options": ["extra_user_part", "system_prompt", "off"],
        "labels": ["附加用户内容（推荐）", "追加系统提示词", "关闭注入"],
        "hint": "推荐附加用户内容，避免每轮改变系统提示词导致缓存失效。"
      },
      "max_inject_memories": {
        "description": "最多注入记忆条数",
        "type": "int",
        "default": 6,
        "slider": { "min": 1, "max": 20, "step": 1 }
      },
      "max_inject_chars": {
        "description": "注入内容最大字符数",
        "type": "int",
        "default": 1200,
        "slider": { "min": 200, "max": 4000, "step": 100 }
      },
      "max_profile_chars": {
        "description": "注入画像最大字符数",
        "type": "int",
        "default": 700,
        "slider": { "min": 200, "max": 2000, "step": 100 }
      }
    }
  },
  "advanced": {
    "description": "高级设置",
    "type": "object",
    "collapsed": true,
    "items": {
      "llm_provider_id": {
        "description": "记忆整理使用的模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话的模型。"
      },
      "vision_provider_id": {
        "description": "图片识别使用的模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用记忆整理模型；该模型必须支持图片输入。"
      },
      "enable_llm_tools": {
        "description": "向模型暴露记忆工具",
        "type": "bool",
        "default": true,
        "hint": "注册 recall_user_memory / save_user_memory 两个函数工具，修改后需重载插件。"
      },
      "debug": {
        "description": "输出调试日志",
        "type": "bool",
        "default": false
      }
    }
  }
}
